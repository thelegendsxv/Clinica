<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane style="-fx-background-color: #aab7b8;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="co.edu.uniquindio.clinica.controladores.ListarServiciosControlador">
    <children>
        <VBox alignment="TOP_CENTER" layoutX="10.0" spacing="10" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.799999999999955" AnchorPane.topAnchor="0.0">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Lista de Servicios" />
            <TableView fx:id="tbServicios" prefHeight="300" prefWidth="500" style="-fx-background-color: #fae5d3;">
                <columns>
                    <TableColumn fx:id="clNombre" prefWidth="250" style="-fx-background-color: #d5dbdb;" text="Nombre" />
                    <TableColumn fx:id="clPrecio" prefWidth="250" style="-fx-background-color: #d5dbdb;" text="Precio" />
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
