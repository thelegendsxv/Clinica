<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.clinica.controladores.ListarServiciosControlador"
      alignment="TOP_CENTER"
      spacing="20"
      style="-fx-background-color: #aab7b8; -fx-padding: 20;">

    <HBox alignment="CENTER">
        <Label text="Lista de Servicios" textFill="#0f0f0f">
            <font>
                <Font size="20.0" />
            </font>
        </Label>
    </HBox>

    <TableView fx:id="tbServicios" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #fae5d3;"
               columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
        <columns>
            <TableColumn fx:id="clNombre" text="Nombre" prefWidth="150.0"/>
            <TableColumn fx:id="clPrecio" text="Precio" prefWidth="100.0"/>
        </columns>
    </TableView>

</VBox>
