<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="Vbox" spacing="20.0" style="-fx-background-color: #aab7b8;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.clinica.controladores.ListaPacientesControlador">


    <Label fx:id="textListaPacientes" text="Lista de Pacientes" textFill="#0f0f0f" translateX="120.0" translateY="10.0">
        <font>
            <Font size="20.0" />
        </font>
    </Label>


    <TableView fx:id="tablaPacientes" style="-fx-background-color: #fae5d3;" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="tablaIdentificacion" style="-fx-background-color: #d5dbdb;" text="Identificación" />
            <TableColumn fx:id="tablaNombre" style="-fx-background-color: #d5dbdb;" text="Nombre" />
            <TableColumn fx:id="tablaTelefono" style="-fx-background-color: #d5dbdb;" text="Teléfono" />
            <TableColumn fx:id="tablaCorreo" style="-fx-background-color: #d5dbdb;" text="Correo" />
            <TableColumn fx:id="tablaSuscripcion" style="-fx-background-color: #d5dbdb;" text="Suscripción" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>


</VBox>
